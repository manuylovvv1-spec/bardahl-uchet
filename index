<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BARDAHL — учёт заказов</title>
<style>
  body{margin:16px auto;padding:12px;max-width:650px;background:#111;color:#eee;font:17px Arial,sans-serif}
  h1,b{color:#ffd400}
  input,select,button{box-sizing:border-box;width:100%;padding:13px;margin:6px 0;font-size:17px;border-radius:7px}
  input,select{background:#222;color:white;border:1px solid #666}
  button{background:#ffd400;color:#111;border:0;font-weight:bold}
  article{border:1px solid #555;border-radius:8px;padding:12px;margin:10px 0}
  .remove{width:auto;padding:7px 12px;margin-left:8px;background:#555;color:white}
</style>
</head>
<body>
<h1>BARDAHL</h1>

<input id="car" placeholder="Автомобиль / госномер">

<select id="service"></select>
<input id="custom" placeholder="Название услуги СТО" hidden>
<input id="price" type="number" inputmode="decimal" placeholder="Цена, ₸">

<button id="add">Добавить услугу</button>
<div id="cart"></div>
<b id="cartTotal">Итого: 0 ₸</b>
<button id="save">Сохранить заказ</button>

<h2>Отчёты</h2>
<input id="date" type="date">
<div id="report"></div>
<div id="orders"></div>

<script>
const services = [
  ["Замена масла в двигателе", 1200],
  ["Замена фильтра воздушного", 200],
  ["Замена фильтра салонного", 200],
  ["Демонтаж защиты", 500],
  ["Демонтаж защиты сложной", 1000],
  ["Замена тормозной жидкости", 2000],
  ["Замена масла в АКПП (со снятием поддона)", 4000],
  ["Замена масла в АКПП (без снятия поддона)", 3000],
  ["Замена масла в вариаторе", 5000],
  ["Замена масла в раздаточной коробке", 2000],
  ["Замена масла в редукторе", 2000],
  ["Замена охлаждающей жидкости", 5500],
  ["Замена жидкости ГУРа", 1500],
  ["Замена жидкости ГУРа (с маслом клиента)", 3000],
  ["Замена жидкости ГУРа со снятием бачка", 2000],
  ["Замена жидкости ГУРа со снятием бачка (с маслом клиента)", 4000],
  ["Замена жидкости сцепления", 4000],
  ["Замена колодок тормозных (с колодками клиента)", 2000],
  ["Замена колодок тормозных внедорожник", 3000],
  ["Замена колодок тормозных с электроручником", 4500],
  ["Замена масла в DSG", 4000],
  ["Замена масла в DSG (с маслом клиента)", 5000],
  ["Замена масла в АКПП (без снятия поддона) с маслом клиента", 4000],
  ["Замена масла в АКПП (со снятием балки и поддона)", 5000],
  ["Замена масла в АКПП (со снятием балки и поддона) с маслом клиента", 8000],
  ["Замена масла в АКПП (со снятием поддона) с маслом клиента", 6000],
  ["Замена масла в вариаторе (с маслом клиента)", 8000],
  ["Замена масла в МКПП", 2000],
  ["Замена масла в муфте HALDEX (без снятия крышки)", 7500],
  ["Замена масла в муфте HALDEX (со снятием крышки)", 12500],
  ["Замена охлаждающей жидкости в двухконтурной системе", 7000],
  ["Замена охлаждающей жидкости с химией", 10500],
  ["Замена тормозной жидкости (с жидкостью клиента)", 3000],
  ["Заправка кондиционера", 3000],
  ["Нарезка резьбы", 2000]
];

const $ = id => document.getElementById(id);
let cart = [];
let orders = [];

try {
  orders = JSON.parse(localStorage.getItem("bardahlOrders") || "[]");
  if (!Array.isArray(orders)) orders = [];
} catch (e) {
  orders = [];
}

for (const [name, price] of services) {
  const option = document.createElement("option");
  option.value = name;
  option.textContent = `${name} — ${price} ₸`;
  option.dataset.price = price;
  $("service").append(option);
}

const customOption = document.createElement("option");
customOption.value = "Услуга СТО";
customOption.textContent = "Услуга СТО — вручную";
$("service").append(customOption);

const now = new Date();
$("date").value =
  `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,"0")}-${String(now.getDate()).padStart(2,"0")}`;

$("service").onchange = () => {
  const option = $("service").selectedOptions[0];
  const manual = option.value === "Услуга СТО";
  $("custom").hidden = !manual;
  $("price").value = option.dataset.price || "";
};
$("service").onchange();

$("add").onclick = () => {
  const option = $("service").selectedOptions[0];
  const manual = option.value === "Услуга СТО";
  const name = manual ? $("custom").value.trim() : option.value;
  const price = Number($("price").value);

  if (!name || !Number.isFinite(price) || price <= 0) {
    alert("Укажите услугу и цену больше нуля.");
    return;
  }

  cart.push({name, price});
  $("custom").value = "";
  drawCart();
};

function drawCart() {
  const container = $("cart");
  container.replaceChildren();

  cart.forEach((item, index) => {
    const row = document.createElement("div");
    row.textContent = `${item.name} — ${item.price} ₸ `;

    const remove = document.createElement("button");
    remove.className = "remove";
    remove.textContent = "Убрать";
    remove.onclick = () => {
      cart.splice(index, 1);
      drawCart();
    };

    row.append(remove);
    container.append(row);
  });

  $("cartTotal").textContent =
    `Итого: ${cart.reduce((sum, item) => sum + item.price, 0)} ₸`;
}

$("save").onclick = () => {
  const car = $("car").value.trim();

  if (!car || cart.length === 0) {
    alert("Укажите автомобиль и добавьте хотя бы одну услугу.");
    return;
  }

  const order = {
    car,
    date: $("date").value,
    items: [...cart],
    total: cart.reduce((sum, item) => sum + item.price, 0)
  };

  orders.push(order);

  try {
    localStorage.setItem("bardahlOrders", JSON.stringify(orders));
  } catch (e) {
    orders.pop();
    alert("Не удалось сохранить заказ. Откройте приложение в Safari по HTTPS-ссылке.");
    return;
  }

  cart = [];
  $("car").value = "";
  drawCart();
  drawReport();
};

$("date").onchange = drawReport;

function drawReport() {
  const date = $("date").value;
  const month = date.slice(0, 7);
  const year = date.slice(0, 4);

  const periods = [
    ["День", orders.filter(o => o.date === date)],
    ["Месяц", orders.filter(o => o.date.startsWith(month))],
    ["Год", orders.filter(o => o.date.startsWith(year))]
  ];

  $("report").textContent = periods.map(([name, list]) =>
    `${name}: ${list.length} машин, ${list.reduce((sum, o) => sum + o.total, 0)} ₸`
  ).join(" | ");

  const list = $("orders");
  list.replaceChildren();

  for (const order of orders.filter(o => o.date === date)) {
    const article = document.createElement("article");
    const details = order.items.map(i => `${i.name} — ${i.price} ₸`).join("; ");
    article.textContent = `${order.car}: ${details}. Итого: ${order.total} ₸`;
    list.append(article);
  }
}

drawReport();
</script>
</body>
</html>